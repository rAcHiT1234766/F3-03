{
  "extends": "./tsconfig.app.json",

  // Test files only; application code they import is included via module resolution.
  "include": ["tests/unit/**/*", "tests/emulator/**/*", "tests/setup.ts", "env.d.ts"],
  "exclude": [],

  "compilerOptions": {
    // Vitest runs in a different environment than the application code.
    "lib": ["ES2023", "DOM"],
    "types": ["node", "jsdom"],
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.vitest.tsbuildinfo"
  }
}
