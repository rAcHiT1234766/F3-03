{
  "name": "fieldlog",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:emulator": "vite --mode emulator",
    "build": "run-p typecheck \"build-only {@}\" --",
    "build-only": "vite build",
    "preview": "vite preview",
    "lint": "run-s lint:oxlint lint:eslint",
    "lint:oxlint": "oxlint .",
    "lint:eslint": "eslint . --cache",
    "format": "prettier --write src/ tests/ scripts/",
    "typecheck": "vue-tsc --build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "emulators": "node scripts/firebase-emulators.mjs emulators:start --only auth,firestore --project demo-fieldlog",
    "test:rules": "node scripts/firebase-emulators.mjs emulators:exec --only firestore --project demo-fieldlog \"vitest run --config vitest.emulator.config.ts tests/emulator/rules\"",
    "test:sync": "node scripts/firebase-emulators.mjs emulators:exec --only auth,firestore --project demo-fieldlog \"vitest run --config vitest.emulator.config.ts tests/emulator/sync\"",
    "build:e2e": "node scripts/build-e2e.mjs",
    "test:e2e": "run-s build:e2e e2e",
    "e2e": "playwright test",
    "check": "run-s lint typecheck test build-only",
    "icons": "node scripts/generate-icons.mjs",
    "send-test-push": "node scripts/send-test-push.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@lucide/vue": "1.54.0",
    "dexie": "^4.4.7",
    "firebase": "^13.1.0",
    "vue": "^3.5.42",
    "vue-router": "^5.3.1",
    "workbox-core": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-window": "^7.4.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@playwright/test": "^1.63.0",
    "@tsconfig/node24": "^24.0.5",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.13.4",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^4.1.12",
    "@vitest/eslint-plugin": "^1.6.27",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "~1.82.0",
    "eslint-plugin-playwright": "^2.12.0",
    "eslint-plugin-vue": "~10.11.0",
    "fake-indexeddb": "^6.2.6",
    "firebase-admin": "^14.5.0",
    "firebase-tools": "^15.34.1",
    "jiti": "^2.7.0",
    "jsdom": "^30.0.1",
    "npm-run-all2": "^9.0.3",
    "oxlint": "~1.82.0",
    "prettier": "3.9.6",
    "typescript": "~6.0.0",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^4.1.11",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.11"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  }
}
