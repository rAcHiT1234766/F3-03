# Public Firebase web-app configuration (Project settings → Your apps → Web app).
# These values are bundled into the browser app. They identify the project; they are NOT secrets
# and do not grant access — Firestore rules and Firebase Auth do. Never put Admin credentials here.
# Copy to .env.local (git-ignored) and fill in.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_STORAGE_BUCKET=
# Public web-push key (Project settings → Cloud Messaging → Web Push certificates).
VITE_FIREBASE_VAPID_KEY=

# Development only: use the local Auth/Firestore emulators. Requires a demo- project ID.
# Prefer `npm run dev:emulator`, which loads .env.emulator instead.
VITE_USE_EMULATORS=false
# VITE_EMULATOR_HOST=127.0.0.1
# VITE_AUTH_EMULATOR_PORT=9099
# VITE_FIRESTORE_EMULATOR_PORT=8086
