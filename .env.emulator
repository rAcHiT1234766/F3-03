# Emulator mode (vite --mode emulator). Committed on purpose: demo-* projects exist only in the
# local emulators, so these placeholder values can never reach a real Firebase project.
VITE_USE_EMULATORS=true
VITE_FIREBASE_PROJECT_ID=demo-fieldlog
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-fieldlog.firebaseapp.com
VITE_FIREBASE_APP_ID=1:000000000000:web:demo
VITE_EMULATOR_HOST=127.0.0.1
VITE_AUTH_EMULATOR_PORT=9099
VITE_FIRESTORE_EMULATOR_PORT=8086
